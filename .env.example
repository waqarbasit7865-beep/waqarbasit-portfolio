# Copy to .env.local for local overrides. Never put secrets here — every VITE_ variable is public.

# Show draft projects, placeholder images and "missing content" notes.
# Leave unset/false for the public production site. Set to true for preview deployments.
VITE_SHOW_DRAFTS=false

# Your final public URL (used for canonical links, Open Graph and sitemap.xml). No trailing slash.
VITE_SITE_URL=https://waqarbasit.pages.dev
